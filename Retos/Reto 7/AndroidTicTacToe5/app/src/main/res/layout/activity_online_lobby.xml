<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Estado de Conexión -->
    <TextView
        android:id="@+id/tv_connection_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:text="🟢 Conectado a la nube"
        android:textColor="#388E3C"
        android:textSize="13sp" />

    <!-- Sección del Jugador y Crear Partida -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#F5F5F5"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Jugador:"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_player_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_player_name"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_create_game"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/btn_create_game"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Encabezado de Lista -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Juegos disponibles:"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Mensaje cuando la lista esté vacía (ListView.setEmptyView se encarga) -->
    <TextView
        android:id="@+id/tv_empty_games"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/no_games_available"
        android:textColor="#757575"
        android:visibility="gone" />

    <!-- Lista de Juegos -->
    <ListView
        android:id="@+id/lv_available_games"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp" />

</LinearLayout>